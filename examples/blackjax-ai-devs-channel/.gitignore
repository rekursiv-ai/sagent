# Runtime artifacts — these are produced when serve.py is running and
# are never source of truth. The plugin's `sessions/` dir is the
# scratchpad: per-role MCP configs, per-role trace files, and the
# audit-suppression sentinel.
main.jsonl
sessions/*.trace.jsonl
sessions/*.mcp.json
sessions/_suppress_audit
sessions/mcp_calls.log

# Python
__pycache__/
*.pyc
.pytest_cache/
