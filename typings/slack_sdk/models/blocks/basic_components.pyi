class Option(JsonObject):
    attributes: set[str] = ...
    logger = ...
    label_max_length = ...
    value_max_length = ...
    def __init__(
        self,
        *,
        value: str,
        label: str | None = ...,
        text: str | dict[str, Any] | TextObject | None = ...,
        description: str | dict[str, Any] | TextObject | None = ...,
        url: str | None = ...,
        **others: dict[str, Any],
    ) -> None: ...
    @classmethod
    def parse_all(
        cls, options: Sequence[dict[str, Any] | Option] | None
    ) -> list[Option] | None: ...
    def to_dict(self, option_type: str = ...) -> dict[str, Any]: ...
    @staticmethod
    def from_single_value(value_and_label: str) -> Option: ...

class OptionGroup(JsonObject):
