class TextObject(JsonObject):
    logger = ...
    @property
    def subtype(self) -> str | None: ...
    @classmethod
    def parse(
        cls, text: str | dict[str, Any] | TextObject, default_type: str = ...
    ) -> TextObject | None: ...
    def __init__(
        self,
        text: str,
        type: str | None = ...,
        subtype: str | None = ...,
        emoji: bool | None = ...,
        **kwargs,
    ) -> None: ...

class PlainTextObject(TextObject):
    type = ...
    @property
    def attributes(self) -> set[str]: ...
    def __init__(self, *, text: str, emoji: bool | None = ...) -> None: ...
    @staticmethod
    def from_str(text: str) -> PlainTextObject: ...
    @staticmethod
    def direct_from_string(text: str) -> dict[str, Any]: ...

class MarkdownTextObject(TextObject):
    type = ...
    @property
    def attributes(self) -> set[str]: ...
    def __init__(self, *, text: str, verbatim: bool | None = ...) -> None: ...
    @staticmethod
    def from_str(text: str) -> MarkdownTextObject: ...
    @staticmethod
    def direct_from_string(text: str) -> dict[str, Any]: ...
    @staticmethod
    def from_link(link: Link, title: str = ...) -> MarkdownTextObject: ...
    @staticmethod
    def direct_from_link(link: Link, title: str = ...) -> dict[str, Any]: ...

class RawTextObject(TextObject):
    type = ...
    @property
    def attributes(self) -> set[str]: ...
    def __init__(self, *, text: str) -> None: ...
    @staticmethod
    def from_str(text: str) -> RawTextObject: ...
    @staticmethod
