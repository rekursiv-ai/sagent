    def to_dict(self, option_type: str = ...) -> dict[str, Any]: ...

class ConfirmObject(JsonObject):
    attributes: set[str] = ...
    title_max_length = ...
    text_max_length = ...
    confirm_max_length = ...
    deny_max_length = ...
    @classmethod
    def parse(cls, confirm: ConfirmObject | dict[str, Any]) -> ConfirmObject | None: ...
    def __init__(
        self,
        *,
        title: str | dict[str, Any] | PlainTextObject,
        text: str | dict[str, Any] | TextObject,
        confirm: str | dict[str, Any] | PlainTextObject = ...,
        deny: str | dict[str, Any] | PlainTextObject = ...,
        style: str | None = ...,
    ) -> None: ...
