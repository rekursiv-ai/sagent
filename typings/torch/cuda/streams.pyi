from typing import Self

import torch

class Stream(torch._C._CudaStreamBase):
    def __new__(cls, device=..., priority=..., **kwargs) -> Self: ...
    def wait_event(self, event) -> None: ...
    def wait_stream(self, stream: Stream) -> None: ...
    def record_event(self, event=...) -> torch.cuda.streams.Event | torch._C.Event: ...
    def query(self) -> bool: ...
    def synchronize(self) -> None: ...
    def __eq__(self, o) -> bool: ...
    def __hash__(self) -> int: ...

class ExternalStream(Stream):
    def __new__(cls, stream_ptr, device=..., **kwargs) -> Self: ...

class Event(torch._C._CudaEventBase):
    def __new__(
        cls, enable_timing=..., blocking=..., interprocess=..., external=...
    ) -> Self: ...
    @classmethod
    def from_ipc_handle(cls, device, handle) -> _CudaEventBase: ...
    def record(self, stream=...) -> None: ...
    def wait(self, stream=...) -> None: ...
    def query(self) -> bool: ...
    def elapsed_time(self, end_event: Event) -> float: ...
    def synchronize(self) -> None: ...
    def ipc_handle(self) -> bytes: ...
