    def forward_post_hook(
        self, module: nn.Module, input: tuple[torch.Tensor], output: torch.Tensor
    ) -> torch.Tensor: ...

def unimplemented_deepcopy(*args: Any, **kwargs: Any) -> NoReturn: ...

class DDP:
    def __new__(cls, *args, **kwargs): ...
