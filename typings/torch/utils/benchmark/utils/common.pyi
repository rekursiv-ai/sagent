from typing import Any

import dataclasses

@dataclasses.dataclass
class TaskSpec:
    stmt: str
    setup: str
    global_setup: str = ...
    label: str | None = ...
    sub_label: str | None = ...
    description: str | None = ...
    env: str | None = ...
    num_threads: int = ...
    @property
    def title(self) -> str: ...
    def summarize(self) -> str: ...

@dataclasses.dataclass
class Measurement:
    number_per_run: int
    raw_times: list[float]
    task_spec: TaskSpec
    metadata: dict[Any, Any] | None = ...
    @property
    def times(self) -> list[float]: ...
    @property
    def median(self) -> float: ...
    @property
    def mean(self) -> float: ...
    @property
    def iqr(self) -> float: ...
    @property
    def significant_figures(self) -> int: ...
    @property
    def has_warnings(self) -> bool: ...
    @property
    def title(self) -> str: ...
    @property
    def env(self) -> str: ...
    @property
    def as_row_name(self) -> str: ...
    def meets_confidence(self, threshold: float = ...) -> bool: ...
    @staticmethod
    def merge(measurements: list[Measurement]) -> list[Measurement]: ...

def select_unit(t: float) -> tuple[str, float]: ...
def unit_to_english(u: str) -> str: ...
def trim_sigfig(x: float, n: int) -> float: ...
def ordered_unique(elements: list[Any]) -> list[Any]: ...
