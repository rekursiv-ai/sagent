@dataclass
class BaseWatermarkingConfig(ABC):
    @classmethod
    def from_dict(cls, config_dict, **kwargs):  # -> Self:
        ...
    def to_json_file(self, json_file_path: str | os.PathLike):  # -> None:
        ...
    def to_dict(self) -> dict[str, Any]: ...
    def __iter__(self):  # -> Generator[tuple[str, Any], Any, None]:
        ...
    def __repr__(self):  # -> str:
        ...
    def to_json_string(self):  # -> str:
        ...
    def update(self, **kwargs):  # -> None:
        ...
    @abstractmethod
    def validate(self):  # -> None:
        ...
    @abstractmethod
    def construct_processor(self, vocab_size):  # -> None:
        ...

@dataclass
class WatermarkingConfig(BaseWatermarkingConfig):
    def __init__(
        self,
        greenlist_ratio: float = ...,
        bias: float = ...,
        hashing_key: int = ...,
        seeding_scheme: str = ...,
        context_width: int = ...,
    ) -> None: ...
    def validate(self):  # -> None:
        ...
    def construct_processor(
        self, vocab_size: int, device
    ) -> WatermarkLogitsProcessor: ...

@dataclass
class SynthIDTextWatermarkingConfig(BaseWatermarkingConfig):
    def __init__(
        self,
        ngram_len: int,
        keys: list[int],
        context_history_size: int = ...,
        sampling_table_seed: int = ...,
        sampling_table_size: int = ...,
        skip_first_ngram_calls: bool = ...,
        debug_mode: bool = ...,
    ) -> None: ...
    def validate(self):  # -> None:
        ...
    def construct_processor(
        self, vocab_size: int, device
    ) -> WatermarkLogitsProcessor: ...

